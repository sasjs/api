{
  "name": "@sasjs/api",
  "version": "0.0.0-semantically-released",
  "description": "The SASjs Server API, described once - a generated route table, the services behind it, and the conformance corpus both hosts run",
  "license": "MIT",
  "author": "SASjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasjs/api.git"
  },
  "homepage": "https://github.com/sasjs/api#readme",
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    },
    "./code": {
      "types": "./build/esm/code/index.d.ts",
      "import": "./build/esm/code/index.js",
      "require": "./build/cjs/code/index.js"
    }
  },
  "files": [
    "build",
    "README.md",
    "LICENCE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "scripts": {
    "build": "rimraf build && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/postbuild.mjs && node scripts/build-browser.mjs",
    "test": "jest --coverage",
    "coverage:comment": "node scripts/coverage-comment.mjs",
    "test:watch": "jest --watch",
    "lint": "prettier --check \"{src,spec,scripts}/**/*.{ts,mjs,md}\" \"*.{json,md}\"",
    "lint:fix": "prettier --write \"{src,spec,scripts}/**/*.{ts,mjs,md}\" \"*.{json,md}\"",
    "sync:routes": "node scripts/sync-routes.mjs",
    "check:routes": "node scripts/sync-routes.mjs --check",
    "audit:gate": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "deepmerge": "file:./vendor/deepmerge",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "rimraf": "6.1.4",
    "semantic-release": "25.0.9",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "dependencies": {
    "@sasjs/lint": "5.0.0"
  }
}
