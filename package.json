{
  "name": "@sasjs/api",
  "version": "0.0.0",
  "description": "The SASjs Server API, described once - a generated route table, the services behind it, and the conformance corpus both hosts run",
  "license": "MIT",
  "author": "SASjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasjs/api.git"
  },
  "homepage": "https://github.com/sasjs/api#readme",
  "main": "build/cjs/index.js",
  "module": "build/esm/index.js",
  "types": "build/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    },
    "./code": {
      "types": "./build/esm/code/index.d.ts",
      "import": "./build/esm/code/index.js",
      "require": "./build/cjs/code/index.js"
    }
  },
  "files": [
    "build",
    "README.md",
    "LICENCE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "scripts": {
    "build": "rimraf build && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/postbuild.mjs && node scripts/build-browser.mjs",
    "test": "jest --coverage",
    "coverage:comment": "node scripts/coverage-comment.mjs",
    "test:watch": "jest --watch",
    "bench:gates": "node tools/bench-gates.cjs",
    "lint": "prettier --check \"{src,spec,scripts,tools}/**/*.{ts,mjs,cjs,md}\" \"*.{json,md}\"",
    "lint:fix": "prettier --write \"{src,spec,scripts,tools}/**/*.{ts,mjs,cjs,md}\" \"*.{json,md}\"",
    "sync:routes": "node scripts/sync-routes.mjs",
    "check:routes": "node scripts/sync-routes.mjs --check",
    "sync:scope": "node scripts/viya-scope.mjs",
    "check:scope": "node scripts/viya-scope.mjs --check",
    "sync:viya": "node scripts/viya-generate.mjs",
    "check:viya": "node scripts/viya-generate.mjs --check",
    "check:builds": "node scripts/check-builds.mjs",
    "check:package": "node scripts/check-package.mjs",
    "audit:gate": "sasjs-release --audit --audit-level info --audit-require-source --audit-require-severity",
    "check:appstream": "node scripts/appstream-browser-check.cjs",
    "conformance": "node tools/viya-conformance/conformance.mjs",
    "release": "sasjs-release",
    "prepublishOnly": "node -e \"const v=require('./package.json').version; if (/^0\\.0\\.0/.test(v)) { console.error('refusing to publish ' + v + ': the version is stamped from the tag by @sasjs/release --prepare-publish'); process.exit(1) }\""
  },
  "devDependencies": {
    "@sasjs/release": "0.15.0",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "deepmerge": "file:./vendor/deepmerge",
    "esbuild": "0.28.2",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "rimraf": "6.1.4",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  },
  "dependencies": {
    "@sasjs/lint": "5.5.10"
  }
}
